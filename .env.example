# Copy to .env and fill in. .env is gitignored.

# Postgres from docker-compose.yml, reached from the host.
DATABASE_URL=postgres://thegreendiamond:thegreendiamond@localhost:5432/thegreendiamond

# Elasticsearch from docker-compose.yml, reached from the host.
ELASTICSEARCH_URL=http://localhost:9200

# OpenAlex API key, used by the harvester. Get one at https://openalex.org/settings/api
OPENALEX_API_KEY=
